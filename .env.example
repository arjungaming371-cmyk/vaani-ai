# ============ VAANI AI PLATFORM ============
NEXT_PUBLIC_APP_URL=https://your-domain.com

# --- PostgreSQL (local) ---
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=vaani
PG_USER=postgres
PG_PASSWORD=your-password

# --- Ollama (local AI — Vaani's brain, self-hosted) ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_GPU=false
OLLAMA_MAX_CONCURRENT=2          # 2 for GPU, 1 for CPU-only

# --- Google Login (REQUIRED — dashboard is locked without these) ---
# https://console.cloud.google.com/apis/credentials
# Redirect URI: <NEXT_PUBLIC_APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_SECRET=generate-with-openssl-rand-hex-32
ADMIN_EMAIL=your-gmail@gmail.com

# ============ VOICE STACK (PRIMARY: Twilio + ElevenLabs) ============
CALL_PROVIDER=twilio             # twilio (primary) | exotel (optional fallback)

# --- Twilio ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_CALLER_ID=+1XXXXXXXXXX    # your Twilio number in E.164 format
TWILIO_VOICEBOT_PORT=3004
# Public wss URL of server/voicebot-twilio.js (via your tunnel/nginx):
VOICEBOT_PUBLIC_WSS_URL=wss://your-domain.com/voicebot-twilio

# --- ElevenLabs (Vaani's voice) ---
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2
# Pick voices at https://elevenlabs.io/voice-library (one warm female voice
# works for all three languages with the multilingual model):
ELEVENLABS_VOICE_ID=
ELEVENLABS_VOICE_ID_HINDI=       # optional per-language overrides
ELEVENLABS_VOICE_ID_TELUGU=

# --- Exotel (OPTIONAL fallback — only if CALL_PROVIDER=exotel) ---
EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SUBDOMAIN=api.exotel.com
EXOTEL_CALLER_ID=
EXOTEL_FLOW_APP_ID=

# ============ MESSAGING & SERVICES ============
# --- WhatsApp (self-hosted whatsapp-web.js) ---
WHATSAPP_SERVICE_URL=http://127.0.0.1:3001
WHATSAPP_SERVICE_PORT=3001
WHATSAPP_SERVICE_KEY=generate-a-long-random-string   # shared internal key

# --- Whisper STT (self-hosted) ---
STT_SERVICE_URL=http://127.0.0.1:3003
VOICEBOT_PORT=3002               # Exotel voicebot (only if using Exotel)

# --- Internal ---
APP_INTERNAL_URL=http://127.0.0.1:3000

# --- Email confirmations (OPTIONAL — skipped if blank) ---
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Vaani Admissions <admissions@yourdomain.com>"

# --- Optional: named Cloudflare tunnel (stable URL) ---
# CF_TUNNEL_NAME=niat

# ============ CLOUD DEMO (Vercel) ============
# Set ONLY this on Vercel — the same prompts run on Groq-hosted Llama 3.1 8B.
# Free key: https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
